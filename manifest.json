{
  "manifest_version": 3,
  "name": "EasyStream",
  "version": "2609.14.101",
  "author": "Matcha",
  "description": "Détecte les flux M3U8 et génère les commandes curl, ffmpeg et vlc. © 2026 Matcha",
  "permissions": [
    "webRequest",
    "storage",
    "tabs",
    "downloads",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "EasyStream"
  }
}
